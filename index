<title>Orbit Guard Support</title>
<meta name="claude:viewport-fit-sides" content="cover">
<style>
:root{
  --bg:#0b1226; --fg:#eaf0ff; --muted:#93a0c4; --accent:#5ad1e0; --card:#121b3a;
  padding-left:max(16px, env(safe-area-inset-left,0px));
  padding-right:max(16px, env(safe-area-inset-right,0px));
}
@media (prefers-color-scheme: light){
  :root:not([data-theme="dark"]){ --bg:#f5f7fc; --fg:#131a33; --muted:#5b6690; --accent:#0e8fa3; --card:#ffffff; }
}
:root[data-theme="light"]{ --bg:#f5f7fc; --fg:#131a33; --muted:#5b6690; --accent:#0e8fa3; --card:#ffffff; }
:root[data-theme="dark"]{ --bg:#0b1226; --fg:#eaf0ff; --muted:#93a0c4; --accent:#5ad1e0; --card:#121b3a; color-scheme:dark; }
@media (prefers-color-scheme: dark){ :root:not([data-theme="light"]){ color-scheme:dark; } }

body{ background:var(--bg); color:var(--fg); margin:0; font-family: ui-sans-serif, -apple-system, "Segoe UI", Roboto, sans-serif; }
main{ max-width:560px; margin:0 auto; padding-block:64px 48px; display:flex; flex-direction:column; gap:28px; }
h1{ font-size:28px; margin:0; letter-spacing:-0.02em; }
p{ margin:0; line-height:1.6; color:var(--muted); font-size:15px; }
.card{ background:var(--card); border-radius:16px; padding:24px; display:flex; flex-direction:column; gap:10px; }
.label{ font-size:12px; text-transform:uppercase; letter-spacing:.08em; color:var(--muted); }
.email{ font-size:19px; font-weight:600; color:var(--accent); word-break:break-all; user-select:all; }
button{ align-self:flex-start; background:transparent; border:1px solid var(--accent); color:var(--accent); padding:8px 14px; border-radius:999px; font-size:13px; cursor:pointer; }
button:active{ transform:scale(0.97); }
.faq{ display:flex; flex-direction:column; gap:16px; }
.faq h2{ font-size:13px; text-transform:uppercase; letter-spacing:.08em; color:var(--muted); margin:0 0 4px; }
footer{ color:var(--muted); font-size:12px; }
</style>

<main>
  <div>
    <h1>Orbit Guard — Support</h1>
    <p>Questions, bug reports, or feedback about Orbit Guard — reach out any time.</p>
  </div>

  <div class="card">
    <span class="label">Contact</span>
    <span class="email" id="em">gemluck214@gmail.com</span>
    <button id="cp">Copy email</button>
  </div>

  <div class="faq">
    <div>
      <h2>How do I play?</h2>
      <p>Tap anywhere on screen to spin your shield around the planet and block incoming meteors. Survive as long as you can.</p>
    </div>
    <div>
      <h2>I found a bug</h2>
      <p>Email the address above with your device model and iOS version, plus what you were doing when it happened.</p>
    </div>
    <div>
      <h2>Data &amp; privacy</h2>
      <p>Orbit Guard does not collect or transmit personal data. Scores are stored only on your device.</p>
    </div>
  </div>

  <footer>Orbit Guard · Support page</footer>
</main>

<script>
document.getElementById('cp').addEventListener('click', async () => {
  const el = document.getElementById('cp');
  try {
    await navigator.clipboard.writeText('gemluck214@gmail.com');
    el.textContent = 'Copied';
  } catch (e) {
    const r = document.createRange(); r.selectNode(document.getElementById('em'));
    window.getSelection().removeAllRanges(); window.getSelection().addRange(r);
    el.textContent = 'Select & copy';
  }
  setTimeout(() => el.textContent = 'Copy email', 1500);
});
</script>
